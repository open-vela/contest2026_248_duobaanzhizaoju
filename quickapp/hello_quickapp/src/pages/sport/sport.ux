<script>
/**
 * Xsport Sport — 选择项目（原型 #2）
 * 480×480 圆屏：标题 + 2×2 网格卡（跳绳/跑步/仰卧起坐/更多）
 * 更多 → 第二页（800米/1000米/立定跳远/引体向上/坐位体前屈/返回）
 */
import { TEST_TYPES, getTestById } from '../../common/constants'
var storage = require('@system.storage')
var router = require('@system.router')

var TAG = '[Sport]'
var A = '/common/assets/'
var ICONS = {
  jump_rope: A + 'ic_ropeskip.png', '50m_run': A + 'ic_run.png', '800m_run': A + 'ic_run.png', '1000m_run': A + 'ic_run.png',
  long_jump: A + 'ic_longjump.png', sit_ups: A + 'ic_situp.png', pull_up: A + 'ic_pullup.png', sit_reach: A + 'ic_sitreach.png'
}

export default {
  data: {
    pageOne: [],
    pageTwo: [],
    showAll: false
  },

  onInit() {
    var p1 = [], p2 = []
    for (var i = 0; i < TEST_TYPES.length; i++) {
      var t = TEST_TYPES[i]
      var cell = { id: t.id, label: t.label, icon: ICONS[t.id] || (A + 'ic_run.png') }
      if (t.id === 'jump_rope' || t.id === '50m_run' || t.id === 'sit_ups') p1.push(cell)
      else p2.push(cell)
    }
    this.pageOne = p1
    this.pageTwo = p2
  },

  toggleMore() { this.showAll = !this.showAll },

  pick(cell) {
    var t = getTestById(cell.id)
    if (!t) return
    console.log(TAG, '选择项目:', t.label)
    storage.set({ key: 'current_test', value: JSON.stringify(t) })
    router.push({ uri: '/pages/test' })
  },

  openAnalysis() { router.push({ uri: '/pages/analysis' }) },

  goBack() { router.back() }
}
</script>

<template>
  <div class="page">
    <text class="title">选择项目</text>

    <!-- 体测分析入口（运动页新增项，仅第一页显示） -->
    <div class="ai-entry" if="{{!showAll}}" @click="openAnalysis">
      <image class="ai-ic" src="/common/assets/ic_medal.png"></image>
      <text class="ai-txt">体测分析（AI）</text>
    </div>

    <!-- 第一页：跳绳 / 跑步 / 仰卧起坐 / 更多 -->
    <div class="grid" if="{{!showAll}}">
      <div class="cell" for="{{pageOne}}" @click="pick($item)">
        <image class="cell-icon" src="{{$item.icon}}"></image>
        <text class="cell-label">{{$item.label}}</text>
      </div>
      <div class="cell" @click="toggleMore">
        <image class="cell-more" src="/common/assets/ic_more.png"></image>
        <text class="cell-label">更多</text>
      </div>
    </div>

    <!-- 第二页：其余项目 + 返回 -->
    <div class="grid grid2" if="{{showAll}}">
      <div class="cell cell-s" for="{{pageTwo}}" @click="pick($item)">
        <image class="cell-icon-s" src="{{$item.icon}}"></image>
        <text class="cell-label-s">{{$item.label}}</text>
      </div>
      <div class="cell cell-s" @click="toggleMore">
        <image class="cell-more-s" src="/common/assets/ic_back.png"></image>
        <text class="cell-label-s">返回</text>
      </div>
    </div>

    <!-- 底部返回（第二页空间紧张，由网格内“返回”卡代替） -->
    <image class="back" if="{{!showAll}}" src="/common/assets/ic_back.png" @click="goBack"></image>
  </div>
</template>

<style>
  .page { width: 480px; height: 480px; background-color: #000000; flex-direction: column; align-items: center; }

  .title { font-size: 30px; color: #ffffff; margin-top: 20px; }

  /* 2×2 网格 */
  .grid { width: 388px; flex-direction: row; flex-wrap: wrap; justify-content: center; margin-top: 4px; }
  .cell {
    width: 184px; height: 152px; margin: 5px;
    border-radius: 24px; background-color: #1E1E22;
    flex-direction: column; justify-content: center; align-items: center;
  }
  .cell-icon { width: 56px; height: 56px; }
  .cell-label { font-size: 23px; color: #ffffff; margin-top: 10px; }
  .cell-more { width: 48px; height: 48px; }

  /* 第二页（四行小卡） */
  .grid2 { margin-top: 10px; }
  .cell-s { width: 184px; height: 90px; margin: 4px; border-radius: 20px; }
  .cell-icon-s { width: 36px; height: 36px; }
  .cell-label-s { font-size: 19px; color: #ffffff; margin-top: 4px; }
  .cell-more-s { width: 32px; height: 32px; }

  /* 底部返回箭头 */
  .back { width: 36px; height: 36px; margin-top: 8px; }

  /* 体测分析入口 */
  .ai-entry { flex-direction: row; align-items: center; justify-content: center; width: 300px; height: 52px; margin-top: 4px; border-radius: 26px; background-color: #1E1E22; }
  .ai-ic { width: 28px; height: 28px; margin-right: 10px; }
  .ai-txt { font-size: 22px; color: #2DD4BF; }
</style>
