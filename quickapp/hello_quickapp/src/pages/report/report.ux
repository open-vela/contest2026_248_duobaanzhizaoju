<script>
  /**
   * Xsport Report — 体测成绩（原型 #7）
   * 480×480：标题 + 青色评分环（综合评分）+ 右上等级 🏅
   * + 各项目最新成绩列表（图标 + 名称 + 成绩 + 等级）
   */
  import { getTestById, getGradeInfo, getRecordDisplay } from '../../common/constants'
  var storage = require('@system.storage')
  var router = require('@system.router')

  var TAG = '[Report]'
  var A = '/common/assets/'
  var ICONS = {
    jump_rope: A + 'ic_ropeskip.png', '50m_run': A + 'ic_run.png', '800m_run': A + 'ic_run.png', '1000m_run': A + 'ic_run.png',
    long_jump: A + 'ic_longjump.png', sit_ups: A + 'ic_situp.png', pull_up: A + 'ic_pullup.png', sit_reach: A + 'ic_sitreach.png'
  }

  export default {
    data: {
      totalScore: 86,
      gradeLabel: '良好',
      gradeColor: '#2DD4BF',
      subjects: []
    },

    onInit() {
      this._load()
    },

    _load() {
      var self = this
      storage.get({
        key: 'history_records',
        success: function (data) {
          var list = []
          try { if (data) list = JSON.parse(data) } catch (e) {}
          self._build(list)
        },
        fail: function () { self._build([]) }
      })
    },

    _build(list) {
      list.sort(function (a, b) { return new Date(b.timestamp) - new Date(a.timestamp) })

      /* 每个项目取最新一条 */
      var seen = {}
      var rows = []
      var sum = 0, n = 0
      for (var i = 0; i < list.length; i++) {
        var rec = list[i]
        if (seen[rec.sportId]) continue
        seen[rec.sportId] = true
        var t = getTestById(rec.sportId)
        var disp = getRecordDisplay(rec)
        var g = getGradeInfo(rec.score || 0)
        rows.push({
          icon: ICONS[rec.sportId] || (A + 'ic_run.png'),
          name: rec.sportName || (t ? t.label : rec.sportId),
          valueText: disp.value + disp.unit,
          gradeLabel: g.label,
          gradeColor: g.color
        })
        sum += (rec.score || 0); n++
        if (rows.length >= 3) break
      }

      if (n > 0) {
        this.totalScore = Math.round(sum / n)
        var s = this.totalScore
        if (s >= 90) { this.gradeLabel = '优秀'; this.gradeColor = '#FFD54A' }
        else if (s >= 80) { this.gradeLabel = '良好'; this.gradeColor = '#2DD4BF' }
        else if (s >= 60) { this.gradeLabel = '及格'; this.gradeColor = '#9A9AA0' }
        else { this.gradeLabel = '不及格'; this.gradeColor = '#FF3B30' }
      }
      this.subjects = rows
    },

    goBack() { router.back() }
  }
</script>

<template>
  <div class="page">
    <text class="title">体测成绩</text>

    <!-- 评分环 -->
    <div class="ring"></div>
    <div class="ring-dot"></div>
    <text class="ring-num">{{totalScore}}</text>
    <text class="ring-label">综合评分</text>
    <div class="grade-row">
      <text class="grade" style="color: {{gradeColor}}">{{gradeLabel}}</text>
      <image class="grade-medal" src="/common/assets/ic_medal.png"></image>
    </div>

    <!-- 项目列表 -->
    <div class="rows">
      <div class="row" for="{{subjects}}">
        <image class="row-icon" src="{{$item.icon}}"></image>
        <text class="row-name">{{$item.name}}</text>
        <text class="row-val">{{$item.valueText}}</text>
        <text class="row-grade" style="color: {{$item.gradeColor}}">{{$item.gradeLabel}}</text>
      </div>
    </div>

    <image class="back" src="/common/assets/ic_back.png" @click="goBack"></image>
  </div>
</template>

<style>
  .page { width: 480px; height: 480px; background-color: #000000; flex-direction: column; align-items: center; }

  .title { font-size: 28px; color: #ffffff; margin-top: 24px; }

  /* 评分环 */
  .ring { position: absolute; left: 135px; top: 74px; width: 210px; height: 210px; border-radius: 105px; border-width: 9px; border-color: #2DD4BF; }
  .ring-dot { position: absolute; left: 234px; top: 69px; width: 12px; height: 12px; border-radius: 6px; background-color: #2DD4BF; }
  .ring-num { position: absolute; left: 0; top: 128px; width: 480px; text-align: center; font-size: 64px; color: #ffffff; font-weight: 300; }
  .ring-label { position: absolute; left: 0; top: 204px; width: 480px; text-align: center; font-size: 17px; color: #8E8E93; }
  .grade-row { position: absolute; right: 36px; top: 92px; flex-direction: row; align-items: center; }
  .grade { font-size: 22px; }
  .grade-medal { width: 26px; height: 26px; margin-left: 8px; }

  /* 项目列表 */
  .rows { position: absolute; left: 0; top: 302px; width: 480px; flex-direction: column; align-items: center; }
  .row {
    width: 380px; height: 48px; flex-direction: row; align-items: center;
    border-bottom-width: 1px; border-color: #2A2A2E;
  }
  .row-icon { width: 32px; height: 32px; margin-right: 8px; }
  .row-name { flex: 1; font-size: 21px; color: #ffffff; }
  .row-val { font-size: 21px; color: #ffffff; margin-right: 10px; }
  .row-grade { font-size: 18px; }

  .back { position: absolute; left: 224px; bottom: 16px; width: 32px; height: 32px; }
</style>
