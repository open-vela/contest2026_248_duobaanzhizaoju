<script>
  /**
   * Xsport History — 历史记录（原型 #6）
   * 480×480：标题 + 卡片列表（图标 + 项目名 + 今天 03:00 + 128次 + 90分）
   */
  import { getTestById, getGradeInfo, getRecordDisplay, getRecordDayLabel } from '../../common/constants'
  var storage = require('@system.storage')
  var router = require('@system.router')

  var TAG = '[History]'
  var A = '/common/assets/'
  var ICONS = {
    jump_rope: A + 'ic_ropeskip.png', '50m_run': A + 'ic_run.png', '800m_run': A + 'ic_run.png', '1000m_run': A + 'ic_run.png',
    long_jump: A + 'ic_longjump.png', sit_ups: A + 'ic_situp.png', pull_up: A + 'ic_pullup.png', sit_reach: A + 'ic_sitreach.png'
  }

  export default {
    data: {
      items: []
    },

    onInit() {
      this._load()
    },

    _load() {
      var self = this
      storage.get({
        key: 'history_records',
        success: function (data) {
          var list = []
          try { if (data) list = JSON.parse(data) } catch (e) {}
          self._build(list)
        },
        fail: function () { self._build([]) }
      })
    },

    _build(list) {
      list.sort(function (a, b) { return new Date(b.timestamp) - new Date(a.timestamp) })

      var items = []
      var n = Math.min(list.length, 4)
      for (var i = 0; i < n; i++) {
        var rec = list[i]
        var t = getTestById(rec.sportId)
        var disp = getRecordDisplay(rec)
        var g = getGradeInfo(rec.score || 0)

        var d = new Date(rec.timestamp)
        var dayLabel = getRecordDayLabel(rec.timestamp)
        var hh = String(d.getHours()).padStart(2, '0')
        var mi = String(d.getMinutes()).padStart(2, '0')

        items.push({
          icon: ICONS[rec.sportId] || (A + 'ic_run.png'),
          name: rec.sportName || (t ? t.label : rec.sportId),
          timeText: dayLabel + '  ' + hh + ':' + mi,
          valueText: disp.value + disp.unit,
          scoreText: Math.round(rec.score || 0) + '分',
          scoreColor: g.color,
          rec: rec
        })
      }
      this.items = items
    },

    openDetail(item) {
      router.push({ uri: '/pages/detail', params: { record: JSON.stringify(item.rec) } })
    },

    goBack() { router.back() }
  }
</script>

<template>
  <div class="page">
    <text class="title">历史记录</text>

    <div class="cards">
      <div class="card" for="{{items}}" @click="openDetail($item)">
        <image class="card-icon" src="{{$item.icon}}"></image>
        <div class="info">
          <text class="name">{{$item.name}}</text>
          <text class="time">{{$item.timeText}}</text>
        </div>
        <div class="val-col">
          <text class="val">{{$item.valueText}}</text>
          <text class="score" style="color: {{$item.scoreColor}}">{{$item.scoreText}}</text>
        </div>
      </div>
    </div>

    <image class="back" src="/common/assets/ic_back.png" @click="goBack"></image>
  </div>
</template>

<style>
  .page { width: 480px; height: 480px; background-color: #000000; flex-direction: column; align-items: center; }

  .title { font-size: 28px; color: #ffffff; margin-top: 26px; }

  .cards { width: 390px; flex-direction: column; margin-top: 18px; }
  .card {
    width: 390px; height: 78px; margin-bottom: 10px;
    border-radius: 18px; background-color: #1C1C1E;
    flex-direction: row; align-items: center; padding: 0 18px;
  }
  .card-icon { width: 40px; height: 40px; margin-right: 8px; }
  .info { flex: 1; flex-direction: column; }
  .name { font-size: 22px; color: #ffffff; }
  .time { font-size: 15px; color: #8E8E93; margin-top: 4px; }
  .val-col { flex-direction: column; align-items: flex-end; }
  .val { font-size: 23px; color: #ffffff; }
  .score { font-size: 17px; margin-top: 4px; }

  .back { width: 32px; height: 32px; margin-top: 10px; }
</style>
