  }

  .header-title {
    flex: 1;
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    color: #e6edf3;
  }

  .header-spacer {
    width: 36px;
  }

  .sync-bar {
    flex-direction: row;
    justify-content: space-between;
