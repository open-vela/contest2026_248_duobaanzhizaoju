<script>
  /**
   * Xsport History 历史记录页面
   * 本地记录 + 同步状态 + 服务器查询
   */
  import { TEST_TYPES, STORAGE_KEYS, ROUTES } from '../../common/constants'
  import { getAllRecords, syncPending, getSyncState } from '../../common/sync'
  import { getStudentRecords } from '../../common/network'
  import { read } from '../../common/storage'
  import router from '@system.router'

  const TAB_ITEMS = ['本地记录', '服务器记录']

  export default {
    data: {
      activeTab: 0,
      tabItems: TAB_ITEMS,

      // 本地数据
      localRecords: [],
      pendingCount: 0,
      syncStateText: '',
      syncing: false,

      // 服务器数据
      serverRecords: [],
      serverLoading: false,
      serverError: '',

      // 详情
      detailVisible: false,
      detailRecord: null
    },

    async onInit() {
      await this.loadLocalRecords()
      await this.updateSyncState()
    },

    async loadLocalRecords() {
      this.localRecords = await getAllRecords()
    },

    async updateSyncState() {
      const state = await getSyncState()
      this.pendingCount = state.pending
      if (state.pending > 0) {
        this.syncStateText = `${state.pending} 条待同步`
      } else {
        this.syncStateText = ''
      }
    },

    async switchTab(index) {
      this.activeTab = index
      if (index === 1 && this.serverRecords.length === 0) {
        await this.loadServerRecords()
      }
    },

    async loadServerRecords() {
      this.serverLoading = true
      this.serverError = ''

      try {
        const studentId = await read(STORAGE_KEYS.STUDENT_ID)
        if (!studentId) {
          this.serverError = '请先设置学号'
          return
        }

        const res = await getStudentRecords(studentId)
        this.serverRecords = (res.records || []).sort(
          (a, b) => new Date(b.test_date) - new Date(a.test_date)
        )
      } catch (e) {
        this.serverError = e.message || '网络不可用'
      } finally {
        this.serverLoading = false
      }
    },

    async doSync() {
      this.syncing = true
      try {
        const result = await syncPending()
        this.syncStateText = result.success > 0 ? `已同步 ${result.success} 条` : '同步完成'
      } catch (e) {
        this.syncStateText = `同步失败: ${e.message}`
      } finally {
        this.syncing = false
        await this.loadLocalRecords()
        await this.updateSyncState()
      }
    },

    goHome() {
      router.push({ uri: ROUTES.HOME })
    },

    // ---- 记录展示 ----

    getTestLabel(type) {
      const found = TEST_TYPES.find((t) => t.id === type)
      return found ? found.label : type
    },

    getTestUnit(type) {
      const found = TEST_TYPES.find((t) => t.id === type)
      return found ? found.unit : ''
    },

    getDisplayValue(record) {
      const mode = this.getMode(record.test_type)
      if (mode === 'count') return `${record.count || 0}`
      if (mode === 'time') {
        const sec = record.time_sec || 0
        const m = Math.floor(sec / 60)
        const s = sec % 60
        return `${m}'${String(s).padStart(2, '0')}"`
      }
      return `${record.distance_m || 0}`
    },

    getMode(type) {
      const found = TEST_TYPES.find((t) => t.id === type)
      return found ? found.mode : ''
    },

    getDateStr(dateStr) {
      if (!dateStr) return ''
      const d = new Date(dateStr)
      return `${d.getMonth() + 1}/${d.getDate()} ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`
    },

    isSynced(record) {
      return record._synced === true
    },

    openDetail(record) {
      this.detailRecord = record
      this.detailVisible = true
    },

    closeDetail() {
      this.detailVisible = false
      this.detailRecord = null
    }
  }
</script>

<template>
  <div class="history-page">
    <!-- 标题栏 -->
    <div class="header">
      <div class="header-back" @click="goHome">
        <text class="back-arrow">‹</text>
      </div>
      <text class="header-title">历史记录</text>
      <div class="header-spacer"></div>
    </div>

    <!-- 同步状态条 -->
    <div class="sync-bar" show="{{ syncStateText }}">
      <text class="sync-bar-text">📤 {{syncStateText}}</text>
      <div class="sync-bar-btn" @click="doSync">
        <text class="sync-bar-btn-text">{{ syncing ? '同步中...' : '立即同步' }}</text>
      </div>
    </div>

    <!-- Tab 切换 -->
    <div class="tabs">
      <div
        class="tab-item {{ activeTab === $idx ? 'active' : '' }}"
        for="{{tabItems}}"
        @click="switchTab($idx)"
      >
        <text class="tab-text {{ activeTab === $idx ? 'active' : '' }}">{{$item}}</text>
      </div>
    </div>

    <!-- ====== 本地记录列表 ====== -->
    <list class="record-list" show="{{ activeTab === 0 }}">
      <list-item for="{{ localRecords }}" type="record-card" class="record-item" @click="openDetail($item)">
        <div class="record-card">
          <div class="record-left">
            <text class="record-type">{{getTestLabel($item.test_type)}}</text>
            <text class="record-date">{{getDateStr($item.test_date)}}</text>
          </div>
          <div class="record-right">
            <text class="record-value">{{getDisplayValue($item)}} {{getTestUnit($item.test_type)}}</text>
          </div>
          <div class="record-sync-badge" show="{{ isSynced($item) }}">
            <text class="sync-badge-text">✓</text>
          </div>
        </div>
      </list-item>
      <list-item type="empty-hint" show="{{ localRecords.length === 0 }}">
        <div class="empty-state">
          <text class="empty-icon">📭</text>
          <text class="empty-text">暂无本地记录</text>
          <text class="empty-hint">完成体测后自动保存</text>
        </div>
      </list-item>
    </list>

    <!-- ====== 服务器记录列表 ====== -->
    <div class="record-list" show="{{ activeTab === 1 }}">
      <div class="loading" show="{{ serverLoading }}">
        <text class="loading-text">加载中...</text>
      </div>
      <div class="error" show="{{ serverError }}">
        <text class="error-text">{{serverError}}</text>
      </div>
      <list>
        <list-item for="{{ serverRecords }}" type="record-card" class="record-item" @click="openDetail($item)">
          <div class="record-card">
            <div class="record-left">
              <text class="record-type">{{getTestLabel($item.test_type)}}</text>
              <text class="record-date">{{getDateStr($item.test_date)}}</text>
            </div>
            <div class="record-right">
              <text class="record-value">{{getDisplayValue($item)}} {{getTestUnit($item.test_type)}}</text>
            </div>
          </div>
        </list-item>
        <list-item type="empty-hint" show="{{ serverRecords.length === 0 && !serverLoading && !serverError }}">
          <div class="empty-state">
            <text class="empty-icon">☁️</text>
            <text class="empty-text">暂无服务器记录</text>
          </div>
        </list-item>
      </list>
    </div>

    <!-- ====== 详情弹窗 ====== -->
    <div class="detail-mask" show="{{detailVisible}}" @click="closeDetail">
      <div class="detail-panel">
        <text class="detail-title">体测详情</text>
        <div class="detail-row">
          <text class="detail-key">项目</text>
          <text class="detail-val">{{detailRecord ? getTestLabel(detailRecord.test_type) : ''}}</text>
        </div>
        <div class="detail-row">
          <text class="detail-key">成绩</text>
          <text class="detail-val highlight">{{detailRecord ? getDisplayValue(detailRecord) : ''}} {{detailRecord ? getTestUnit(detailRecord.test_type) : ''}}</text>
        </div>
        <div class="detail-row" show="{{ detailRecord && detailRecord.avg_hr }}">
          <text class="detail-key">平均心率</text>
          <text class="detail-val">{{detailRecord ? detailRecord.avg_hr : ''}} bpm</text>
        </div>
        <div class="detail-row" show="{{ detailRecord && detailRecord.max_hr }}">
          <text class="detail-key">最高心率</text>
          <text class="detail-val">{{detailRecord ? detailRecord.max_hr : ''}} bpm</text>
        </div>
        <div class="detail-row">
          <text class="detail-key">日期</text>
          <text class="detail-val">{{detailRecord ? getDateStr(detailRecord.test_date) : ''}}</text>
        </div>
        <div class="detail-close" @click="closeDetail">
          <text class="detail-close-text">关闭</text>
        </div>
      </div>
    </div>
  </div>
</template>

