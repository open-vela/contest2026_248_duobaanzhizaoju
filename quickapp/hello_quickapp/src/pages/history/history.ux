    padding: 8px 0;
    border-bottom: 2px solid #30363d;
  }

  .tab-item.active {
    border-bottom-color: #1a7f4b;
  }

  .tab-text {
    font-size: 13px;
    color: #8b949e;
  }

  .tab-text.active {
    color: #e6edf3;
    font-weight: 600;
  }

  .record-list {
    flex: 1;
    padding: 0 12px;
  }

  .record-item {
    margin-bottom: 6px;
  }

  .record-card {
    flex-direction: row;
