<script>
/**
 * Xsport Result — 运动小结（原型 #5）
 * 480×480：{{sportName}}完成 + 大次数 + 90分 优秀 🏅
 * + 时长/均心率/最大心率 + 心率区间条 + 完成按钮
 */
var storage = require('@system.storage')
var router = require('@system.router')
var fetch = require('@system.fetch')

var TAG = '[Result]'

export default {
  data: {
    sportName: '',
    mainValue: '0',
    mainUnit: '次',
    score: 0,
    grade: '优秀',
    gradeColor: '#FFD54A',

    durationText: '00:00',
    avgHr: 0,
    maxHr: 0,

    zones: [
      { name: '恢复', pct: 2, color: '#8E8E93' },
      { name: '燃脂', pct: 74, color: '#2DD4BF' },
      { name: '有氧', pct: 20, color: '#FF9F0A' },
      { name: '极限', pct: 4, color: '#FF3B30' }
    ],
    zoneMax: '有氧',

    _resultData: null
  },

  onInit() {
    console.log(TAG, 'Result onInit')
    storage.get({
      key: 'last_result',
      success: function (data) {
        if (!data) return
        try {
          var r = JSON.parse(data)
          this._resultData = r

          this.sportName = r.sportName || ''
          this.mainValue = String(r.value !== undefined ? r.value : 0)
          this.mainUnit = r.unit || '次'

          var scoreNum = Math.round(r.score || 0)
          this.score = scoreNum
          if (scoreNum >= 90) { this.grade = '优秀'; this.gradeColor = '#FFD54A' }
          else if (scoreNum >= 80) { this.grade = '良好'; this.gradeColor = '#2DD4BF' }
          else if (scoreNum >= 60) { this.grade = '及格'; this.gradeColor = '#9A9AA0' }
          else { this.grade = '不及格'; this.gradeColor = '#FF3B30' }

          var avg = parseInt(r.heartRate) || 140
          var max = parseInt(r.maxHr) || 160
          this.avgHr = avg
          this.maxHr = max
          this._computeZones(avg, max)
          this._fmtDuration(r.duration)

          if (r.httpStatus !== 'success' && !r.uploaded) {
            this._doUpload()
          }
        } catch (e) { console.error(TAG, e) }
      }.bind(this)
    })
  },

  _fmtDuration(sec) {
    if (!sec || sec < 0) { this.durationText = '00:00'; return }
    var m = Math.floor(sec / 60)
    var s = Math.floor(sec % 60)
    this.durationText = String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0')
  },

  _computeZones(avg, max) {
    var ratio = max > 0 ? avg / max : 0.7
    var z = [2, 72, 22, 4]
    if (ratio < 0.6) z = [40, 48, 10, 2]
    else if (ratio < 0.7) z = [8, 74, 16, 2]
    else if (ratio < 0.85) z = [2, 24, 68, 6]
    else z = [1, 8, 46, 45]
    var names = ['恢复', '燃脂', '有氧', '极限']
    var colors = ['#8E8E93', '#2DD4BF', '#FF9F0A', '#FF3B30']
    var arr = []
    var maxIdx = 0
    for (var i = 0; i < 4; i++) {
      arr.push({ name: names[i], pct: z[i], color: colors[i] })
      if (z[i] > z[maxIdx]) maxIdx = i
    }
    this.zones = arr
    this.zoneMax = names[maxIdx]
  },

  _doUpload() {
    if (!this._resultData) return
    var record = this._resultData
    storage.get({
      key: 'device_id',
      success: function (devId) {
        storage.get({
          key: 'server_url',
          success: function (serverUrl) {
            if (!serverUrl) serverUrl = 'http://101.35.231.154:9000'
            if (!devId) devId = 'unknown'
            var url = serverUrl + '/api/v1/fitness/upload/batch'
            var bodyData = {
              device_id: devId,
              records: [{
                student_id: record.studentId || '',
                test_type: record.sportId,
                test_date: record.timestamp,
                count: record.mode === 'count' ? record.value : undefined,
                duration_sec: record.duration,
                avg_hr: record.heartRate || 0,
                max_hr: record.maxHr || 0,
                calories: record.calories || 0,
                score: record.score || 0,
                sport_name: record.sportName
              }]
            }
            fetch.fetch({
              url: url, method: 'POST',
              header: { 'Content-Type': 'application/json' },
              data: JSON.stringify(bodyData),
              responseType: 'text',
              success: function () {
                record.uploaded = true
                storage.set({ key: 'last_result', value: JSON.stringify(record) })
              },
              fail: function () { console.error(TAG, '上传失败') }
            })
          }
        })
      }
    })
  },

  finish() {
    router.replace({ uri: '/pages/home' })
  }
}
</script>

<template>
  <div class="page">
    <text class="title">{{sportName}}完成</text>

    <!-- 大数字 + 单位 -->
    <div class="big-row">
      <text class="big-num">{{mainValue}}</text>
      <text class="big-unit">{{mainUnit}}</text>
    </div>

    <!-- 90分 优秀 🏅 -->
    <div class="grade-row">
      <text class="grade-line" style="color: {{gradeColor}}">{{score}}分 {{grade}}</text>
      <image class="grade-medal" src="/common/assets/ic_medal.png"></image>
    </div>

    <!-- 时长 / 均心率 / 最大心率 -->
    <div class="stats">
      <div class="st-col">
        <text class="st-num">{{durationText}}</text>
        <text class="st-key">时长</text>
      </div>
      <div class="st-col">
        <text class="st-num" style="color: #FF3B45">{{avgHr}}</text>
        <text class="st-key">均心率</text>
      </div>
      <div class="st-col">
        <text class="st-num" style="color: #FF3B45">{{maxHr}}</text>
        <text class="st-key">最大心率</text>
      </div>
    </div>

    <!-- 心率区间条 -->
    <div class="zone-row">
      <div class="zone-bar">
        <div class="zone-seg" for="{{zones}}" style="width: {{($item.pct * 2.4)}}px; background-color: {{$item.color}}"></div>
      </div>
      <text class="zone-name">{{zoneMax}}</text>
    </div>

    <!-- 完成按钮 -->
    <div class="btn-finish" @click="finish">
      <text class="btn-finish-txt">完成</text>
    </div>
  </div>
</template>

<style>
  .page { width: 480px; height: 480px; background-color: #000000; flex-direction: column; align-items: center; }

  .title { font-size: 26px; color: #ffffff; margin-top: 30px; }

  .big-row { flex-direction: row; align-items: flex-start; margin-top: 16px; }
  .big-num { font-size: 88px; color: #ffffff; font-weight: 300; line-height: 96px; }
  .big-unit { font-size: 26px; color: #2DD4BF; margin-left: 8px; margin-top: 20px; }

  .grade-row { flex-direction: row; align-items: center; margin-top: 8px; }
  .grade-line { font-size: 26px; }
  .grade-medal { width: 30px; height: 30px; margin-left: 10px; }

  /* 三项统计 */
  .stats { width: 420px; flex-direction: row; justify-content: space-between; margin-top: 24px; padding: 0 20px; }
  .st-col { flex-direction: column; align-items: center; width: 130px; }
  .st-num { font-size: 32px; color: #ffffff; }
  .st-key { font-size: 17px; color: #8E8E93; margin-top: 6px; }

  /* 区间条 */
  .zone-row { flex-direction: row; align-items: center; margin-top: 28px; }
  .zone-bar { width: 240px; height: 10px; flex-direction: row; }
  .zone-seg { height: 10px; border-radius: 5px; margin: 0 3px; }
  .zone-name { font-size: 19px; color: #ffffff; margin-left: 16px; }

  /* 完成按钮 */
  .btn-finish { width: 280px; height: 58px; border-radius: 29px; background-color: #2DD4BF; justify-content: center; align-items: center; margin-top: 32px; }
  .btn-finish-txt { font-size: 24px; color: #ffffff; }
</style>
