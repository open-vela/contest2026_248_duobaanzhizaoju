  .detail-page {
    flex: 1;
    flex-direction: column;
    background-color: #000000;
  }

  .header {
    flex-direction: row;
    align-items: center;
    padding: 16px 12px;
  }

  .header-back {
    width: 36px;
    height: 36px;
    justify-content: center;
    align-items: center;
  }

  .back-arrow {
    font-size: 24px;
    color: #9A9AA0;
  }

  .header-title {
    flex: 1;
    text-align: center;
    font-size: 16px;
    color: #ffffff;
  }

  .header-spacer {
    width: 36px;
  }

  .detail-card {
    flex-direction: column;
    align-items: center;
    padding: 28px 16px;
    margin: 0 12px 12px;
    background-color: #1C1C1E;
    border-radius: 20px;
  }

  .detail-test {
    font-size: 14px;
    color: #9A9AA0;
    margin-bottom: 10px;
  }

  .value-wrap {
    flex-direction: row;
    align-items: baseline;
    margin-bottom: 14px;
  }

  .detail-value {
    font-size: 52px;
    color: #ffffff;
  }

  .detail-unit {
    font-size: 16px;
    color: #9A9AA0;
    margin-left: 4px;
  }

  .grade-badge {
    padding: 6px 20px;
    border-radius: 20px;
    background-color: #2C2C2E;
  }

  .grade-text {
    font-size: 14px;
    font-weight: 700;
  }

  .info-card {
    flex-direction: column;
    margin: 0 12px;
    padding: 16px;
    background-color: #1C1C1E;
    border-radius: 14px;
  }

  .info-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid #2C2C2E;
  }

  .info-key {
    font-size: 13px;
    color: #9A9AA0;
  }

  .info-val {
    font-size: 13px;
    color: #ffffff;
  }

  .info-val.hr {
    color: #FF3B30;
  }
</style>
