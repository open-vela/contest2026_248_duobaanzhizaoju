<script>
  /**
   * Xsport Detail 体测记录详情（深色主题，匹配设计稿）
   */
  import { getTestById, getGradeInfo, getRecordDisplay, fmtRecordTime } from '../../common/constants'

  export default {
    data: {
      record: null,
      testLabel: '',
      displayValue: '',
      displayUnit: '',
      displayDate: '',
      avgHr: 0,
      maxHr: 0,
      gradeLabel: '',
      gradeColor: '#9A9AA0',
      duration: 0
    },

    onInit() {
      const params = this.$app.$def.router.getParams()
      if (params && params.record) {
        try {
          this.showRecord(JSON.parse(params.record))
        } catch (e) {
          console.error('[Xsport] 解析详情数据失败:', e)
        }
      }
    },

    showRecord(record) {
      this.record = record
      const found = getTestById(record.sportId)
      this.testLabel = record.sportName || (found ? found.label : record.sportId)

      const disp = getRecordDisplay(record)
      this.displayValue = disp.value
      this.displayUnit = disp.unit

      if (record.timestamp) {
        this.displayDate = fmtRecordTime(record.timestamp)
      }

      this.avgHr = record.heartRate || 0
      this.maxHr = record.maxHr || 0
      this.duration = record.duration || 0

      const g = getGradeInfo(record.score || 0)
      this.gradeLabel = record.score ? g.label : '暂无评分'
      this.gradeColor = record.score ? g.color : '#9A9AA0'
    },

    goBack() {
      this.$app.$def.router.back()
    }
  }
</script>

<template>
  <div class="detail-page">
    <!-- 顶部导航 -->
    <div class="header">
      <div class="header-back" @click="goBack">
        <text class="back-arrow">&lt;</text>
      </div>
      <text class="header-title">记录详情</text>
      <div class="header-spacer"></div>
    </div>

    <!-- 成绩卡片 -->
    <div class="detail-card">
      <text class="detail-test">{{testLabel}}</text>
      <div class="value-wrap">
        <text class="detail-value">{{displayValue}}</text>
        <text class="detail-unit">{{displayUnit}}</text>
      </div>
      <div class="grade-badge" show="{{ !!gradeLabel }}">
        <text class="grade-text" style="color: {{gradeColor}}">{{gradeLabel}}</text>
      </div>
    </div>

    <!-- 详细信息 -->
    <div class="info-card">
      <div class="info-row">
        <text class="info-key">测试日期</text>
        <text class="info-val">{{displayDate}}</text>
      </div>
      <div class="info-row" show="{{ avgHr > 0 }}">
        <text class="info-key">平均心率</text>
        <text class="info-val hr">{{avgHr}} bpm</text>
      </div>
      <div class="info-row" show="{{ maxHr > 0 }}">
        <text class="info-key">最高心率</text>
        <text class="info-val hr">{{maxHr}} bpm</text>
      </div>
      <div class="info-row" show="{{ duration > 0 }}">
        <text class="info-key">测试时长</text>
        <text class="info-val">{{duration}} 秒</text>
      </div>
    </div>
  </div>
</template>

