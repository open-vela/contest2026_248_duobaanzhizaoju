    border-radius: 20px;
    border: 1px solid #30363d;
  }

  .detail-test {
    font-size: 14px;
    color: #8b949e;
    margin-bottom: 10px;
  }

  .value-wrap {
    flex-direction: row;
    align-items: baseline;
    margin-bottom: 14px;
  }

  .detail-value {
    font-size: 52px;
    font-weight: 300;
    color: #e6edf3;
    font-family: monospace;
  }

  .detail-unit {
    font-size: 16px;
    color: #8b949e;
    margin-left: 4px;
  }

  .grade-badge {
    padding: 6px 20px;
    border-radius: 20px;
    border-width: 1px;
  }

  .grade-text {
    font-size: 14px;
    font-weight: 700;
  }

  .info-card {
    flex-direction: column;
    margin: 0 12px;
    padding: 16px;
    background-color: #161b22;
    border-radius: 14px;
    border: 1px solid #30363d;
  }

  .info-title {
    font-size: 13px;
    font-weight: 600;
    color: #8b949e;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid #30363d;
  }

  .info-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid #21262d;
  }

  .info-key {
    font-size: 13px;
    color: #8b949e;
  }

  .info-val {
    font-size: 13px;
    color: #e6edf3;
    font-weight: 600;
  }

  .info-val.hr {
    color: #f85149;
  }

  .info-val.mono {
    font-family: monospace;
