<script>
  /**
   * Xsport 体测记录 - 快应用入口
   * 中学生体测数据记录手表应用
   *
   * 全局状态管理:
   *   globalStudentId  - 当前登录学生学号
   *   globalDeviceId   - 设备唯一标识
   *   globalServerUrl  - 服务器地址
   *
   * 离线同步机制:
   *   体测记录 -> 本地队列 -> 监听网络 -> 联网自动推送 -> 服务器
   */
  import { STORAGE_KEYS, getTestById } from './common/constants'
  import { read, write } from './common/storage'
  import { init as initNetwork } from './common/network'
  import { startNetworkMonitor, checkAndSync } from './common/sync'

  export default {
    data: {
      globalStudentId: '',
      globalDeviceId: '',
      globalServerUrl: ''
    },

    async onCreate() {
      console.log('[Xsport] 体测记录快应用启动')

      // 首次启动写入演示体测记录（供首页/历史/成绩/勋章页展示）
      await this._seedDemoData()

      // 恢复本地保存的配置
      try {
        this.globalStudentId = (await read(STORAGE_KEYS.STUDENT_ID)) || ''
        this.globalDeviceId = (await read(STORAGE_KEYS.DEVICE_ID)) || ''
        this.globalServerUrl = (await read(STORAGE_KEYS.SERVER_URL)) || ''

        // 初始化网络模块
        initNetwork(this.globalServerUrl)
      } catch (e) {
        console.warn('[Xsport] 恢复配置失败:', e.message)
      }

      // 启动网络监听（联网时自动推送缓存数据）
      startNetworkMonitor()

      // 启动时检查是否有待同步数据
      setTimeout(async () => {
        await checkAndSync()
      }, 2000)
    },

    onDestroy() {
      console.log('[Xsport] 体测记录快应用退出')
    },

    /**
     * 全局数据更新方法 (子页面通过 $app.$def 调用)
     */
    setGlobalData(key, value) {
      this[key] = value
    },

    /**
     * 首次启动写入演示体测记录（不影响已存在的记录）
     */
    async _seedDemoData() {
      try {
        var existing = await read('history_records')
        if (existing) return

        var now = Date.now()
        var DAY = 86400000
        var demo = [
          { id: 'jump_rope', value: 128, unit: '次', mode: 'count', duration: 60, score: 90, hr: 148, max: 168, cal: 18, ago: 0 },
          { id: '50m_run', value: 7.8, unit: '秒', mode: 'time', duration: 8, score: 82, hr: 165, max: 180, cal: 12, ago: 0 },
          { id: 'sit_ups', value: 48, unit: '个', mode: 'count', duration: 60, score: 88, hr: 140, max: 160, cal: 15, ago: 0 },
          { id: 'long_jump', value: 2.35, unit: '米', mode: 'distance', duration: 5, score: 86, hr: 130, max: 155, cal: 8, ago: 1 },
          { id: '800m_run', value: 185, unit: '秒', mode: 'time', duration: 185, score: 85, hr: 170, max: 185, cal: 40, ago: 1 },
          { id: 'pull_up', value: 8, unit: '个', mode: 'count', duration: 30, score: 78, hr: 145, max: 165, cal: 10, ago: 3 },
          { id: '1000m_run', value: 230, unit: '秒', mode: 'time', duration: 230, score: 83, hr: 172, max: 188, cal: 52, ago: 3 }
        ]

        var list = []
        for (var i = 0; i < demo.length; i++) {
          var d = demo[i]
          var t = getTestById(d.id)
          list.push({
            sportId: d.id,
            sportName: t ? t.label : d.id,
            value: d.value,
            unit: d.unit,
            mode: d.mode,
            duration: d.duration,
            score: d.score,
            heartRate: d.hr,
            maxHr: d.max,
            calories: d.cal,
            timestamp: new Date(now - d.ago * DAY - i * 3600000).toISOString(),
            uploaded: true
          })
        }

        await write('history_records', JSON.stringify(list))
        console.log('[Xsport] 已写入', list.length, '条演示记录')
      } catch (e) {
        console.warn('[Xsport] 演示数据写入失败:', e.message)
      }
    }
  }
</script>
