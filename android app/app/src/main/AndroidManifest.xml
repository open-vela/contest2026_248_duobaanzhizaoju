<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".app.FitnessApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitnessManagement"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.FitnessManagement.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.teacher.TeacherHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />

        <activity
            android:name=".ui.student.StudentListActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />

        <activity
            android:name=".ui.student.StudentDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />

        <activity
            android:name=".ui.student.AIReportActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />

        <activity
            android:name=".ui.statistics.ClassStatisticsActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />

        <activity
            android:name=".ui.admin.AdminHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />

        <activity
            android:name=".ui.admin.ClassManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />

        <activity
            android:name=".ui.admin.DeviceManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />

        <activity
            android:name=".ui.admin.TeacherManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />

        <activity
            android:name=".ui.admin.ReportExportActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />
    </application>
</manifest>
