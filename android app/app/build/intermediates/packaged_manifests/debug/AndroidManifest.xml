<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.fitness.management"
    android:versionCode="1"
    android:versionName="1.0.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <permission
        android:name="com.fitness.management.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.fitness.management.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.fitness.management.app.FitnessApp"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.FitnessManagement"
        android:usesCleartextTraffic="true" >
        <activity
            android:name="com.fitness.management.ui.login.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.fitness.management.ui.teacher.TeacherHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />
        <activity
            android:name="com.fitness.management.ui.student.StudentListActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />
        <activity
            android:name="com.fitness.management.ui.student.StudentDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />
        <activity
            android:name="com.fitness.management.ui.student.AIReportActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />
        <activity
            android:name="com.fitness.management.ui.statistics.ClassStatisticsActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />
        <activity
            android:name="com.fitness.management.ui.admin.AdminHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />
        <activity
            android:name="com.fitness.management.ui.admin.ClassManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />
        <activity
            android:name="com.fitness.management.ui.admin.DeviceManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />
        <activity
            android:name="com.fitness.management.ui.admin.TeacherManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />
        <activity
            android:name="com.fitness.management.ui.admin.ReportExportActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />
        <activity
            android:name="com.fitness.management.ui.profile.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />
        <activity
            android:name="com.fitness.management.ui.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.FitnessManagement.NoActionBar" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.fitness.management.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>